{
	"name": "ubuntu-strapi-sveltekit-demo",
	"private": true,
	"workspaces": [
		"cms",
		"web"
	],
	"engines": {
		"node": ">=24 <=26"
	},
	"scripts": {
		"setup": "node scripts/setup.mjs",
		"dev": "concurrently -k -n cms,web \"npm run dev -w cms\" \"npm run dev -w web\"",
		"build": "npm run build -w cms && npm run build:web",
		"build:web": "npm run build -w web",
		"start:cms": "npm run start -w cms",
		"start:web": "npm run start -w web",
		"check": "npm run check -w web",
		"test": "node --test web/src/lib/server/session.test.ts cms/tests/demo-admin.test.mjs",
		"test:e2e": "playwright test",
		"test:cms": "node --test cms/tests/*.test.mjs",
		"test:admin": "playwright test --config cms/playwright.config.ts",
		"format": "prettier --write .",
		"format:check": "prettier --check ."
	},
	"overrides": {
		"dompurify": "^3.4.17"
	},
	"devDependencies": {
		"@playwright/test": "^1.61.1",
		"concurrently": "^9.2.1",
		"prettier": "^3.8.4",
		"prettier-plugin-svelte": "^3.5.2"
	}
}
